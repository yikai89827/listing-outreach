{
  "manifest_version": 3,
  "name": "Listing Outreach",
  "version": "0.1.0",
  "description": "Turn Zillow & Redfin listings into ready-to-send agent outreach — templates & follow-ups stay on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Listing Outreach",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.zillow.com/*",
    "https://zillow.com/*",
    "https://www.redfin.com/*",
    "https://redfin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/*",
        "https://zillow.com/*"
      ],
      "js": ["content/shared.js", "content/zillow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.redfin.com/*",
        "https://redfin.com/*"
      ],
      "js": ["content/shared.js", "content/redfin.js"],
      "run_at": "document_idle"
    }
  ]
}
